                    if (window.showToast && State.variables.toastNotificationsEnabled) {
                        window.showToast("电子钥匙系统", "已获得" + State.temporary.localMsg.digitalKey.room + "电子钥匙，有效期" + State.temporary.localMsg.digitalKey.duration + "分钟", 4000, "success");
                    }
                }
            <</script>>
        <</if>>
        <<script>>
