window.formatMessageTime = function(msgHour, msgMinute, currentHour, currentMinute) {
    const msgTotalMinutes = msgHour * 60 + msgMinute;
    const currentTotalMinutes = currentHour * 60 + currentMinute;
    const diffMinutes = currentTotalMinutes - msgTotalMinutes;
    
    if (diffMinutes < 0) {

        return msgHour + ":" + (msgMinute < 10 ? "0" : "") + msgMinute;
    } else if (diffMinutes === 0) {
        return "刚刚";
    } else if (diffMinutes < 60) {
        return diffMinutes + "分钟前";
    } else if (diffMinutes < 120) {
        return "1小时前";
    } else if (diffMinutes < 1440) {
        const hours = Math.floor(diffMinutes / 60);
        return hours + "小时前";
    } else {
        
        return msgHour + ":" + (msgMinute < 10 ? "0" : "") + msgMinute;
    }
};


