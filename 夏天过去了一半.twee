:: ShowTime [widget] {"position":"650,725","size":"100,100"}
<<widget "showTime">>
    <<if $hour < 19>>
        现在是下午 <<print $hour>>:<<print ($minute < 10 ? "0" : "") + $minute>>
    <<elseif $hour == 19 && $minute == 0>>
        现在是晚上 <<print $hour>>:<<print ($minute < 10 ? "0" : "") + $minute>>
    <<else>>
        <<goto "游戏结束_超时">>
    <</if>>
<</widget>>

<<widget "formatMessageTime">><<nobr>>
    <<set _msgHour = $args[0]>>
    <<set _msgMinute = $args[1]>>
    <<set _currentHour = $hour>>
    <<set _currentMinute = $minute>>
    <<set _msgTotalMinutes = _msgHour * 60 + _msgMinute>>
    <<set _currentTotalMinutes = _currentHour * 60 + _currentMinute>>
    <<set _diffMinutes = _currentTotalMinutes - _msgTotalMinutes>>
    <<if _diffMinutes < 0>>
        <<set _formattedTime = _msgHour + ":" + ((_msgMinute < 10) ? "0" : "") + _msgMinute>>
    <<elseif _diffMinutes == 0>>
        <<set _formattedTime = "刚刚">>
    <<elseif _diffMinutes < 60>>
        <<set _formattedTime = _diffMinutes + "分钟前">>
    <<elseif _diffMinutes < 120>>
        <<set _formattedTime = "1小时前">>
    <<elseif _diffMinutes < 1440>>
        <<set _hours = Math.floor(_diffMinutes / 60)>>
        <<set _formattedTime = _hours + "小时前">>
    <<else>>
        <<set _formattedTime = _msgHour + ":" + ((_msgMinute < 10) ? "0" : "") + _msgMinute>>
    <</if>>
    <<print _formattedTime>>
<</nobr>><</widget>>


