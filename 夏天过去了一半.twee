        <<elseif $CurLocation == "公共吧台">>
            [[继续->吧台]]
        <<elseif $CurLocation == "一楼大厅">>
            [[继续在大厅->一楼大厅]]
        <<elseif $CurLocation == "夹层（休息室）">>
            [[继续在夹层（休息室）->夹层（休息室）]]
        <<elseif $CurLocation == "天台">>
            [[返回天台->天台]]
        <<elseif $CurLocation == "二楼">>
            [[继续在二楼->二楼]]
        <<else>>
            [[继续->$CurLocation]]
        <</if>>
    <<else>>
        <!-- 普通事件的返回逻辑 -->
        <<if $CurLocation == "会议室101" || $CurLocation == "会议室102">>
            [[返回一楼大厅->一楼大厅]]
        <<elseif $CurLocation == "会议室201" || $CurLocation == "会议室202">>
            [[返回二楼->二楼]]
        <<elseif $CurLocation == "工位">>
            [[继续工作->工位]]
        <<elseif $CurLocation == "公共吧台">>
            [[继续->吧台]]
