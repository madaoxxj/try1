        <<elseif $CurLocation == "天台">>
            [[返回天台->天台]]
        <<else>>
            [[继续->$CurLocation]]
        <</if>>
    <</if>>
    <</nobr>>
    
    <<unset $eventSystem["eventChoice"]>>
<<else>>
