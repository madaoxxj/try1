:: StoryScript [script]
$(document).ready(function() {
  const rainContainer = $('<div id="rain"></div>');
  $('body').prepend(rainContainer);
  
  const toastContainer = $('<div id="toast-container"></div>');
  $('body').append(toastContainer);
  
  window.updateRain = function(intensity) {
    const container = $('#rain');
    container.empty();
    
    const dropCount = Math.floor(intensity * 100);
    const opacity = Math.min(0.8, intensity * 0.4);
    
    container.css('opacity', opacity);
    
    for (let i = 0; i < dropCount; i++) {
      const drop = $('<div class="raindrop"></div>');
      

      const width = 1 + Math.random() * 2;
      const height = 10 + Math.random() * 20;
      const left = Math.random() * 100;
      const duration = 0.5 + Math.random() * 0.5;
      
      drop.css({
        width: width + 'px',
        height: height + 'px',
        left: left + '%',
        animation: `fall ${duration}s linear infinite`,
        animationDelay: `-${Math.random() * duration}s`
      });
      
      container.append(drop);
    }
  };
  

  window.showToast = function(from, preview, duration = 4000, type = 'info') {
    const toastId = 'toast-' + Date.now();
    const toast = $(`
      <div class="toast ${type}" id="${toastId}">
        <div class="toast-header">
          <span class="toast-icon"></span>${from}
        </div>
        <div class="toast-content">${preview}</div>
      </div>
    `);
    
    $('#toast-container').append(toast);
    

    setTimeout(() => {
      toast.addClass('show');
    }, 100);
    
    if(!State.variables.gameStarted) {
        SimpleAudio.select("notify").volume(0.5).play();
    }
    

    setTimeout(() => {
      toast.addClass('hide');
      setTimeout(() => {
        toast.remove();
      }, 300);
    }, duration);
    
    toast.on('click', function() {
      if (from !== "测试系统") {
        if (typeof Dialog !== 'undefined') {
          Dialog.create("iphone").wikiPassage("手机").open();
        }
      }
      

      $(this).addClass('hide');
      setTimeout(() => {
        $(this).remove();
      }, 300);
    });
  };
});


window.refreshXhsContent = function() {
    const highPriority = [...State.variables.xhsHighPriority];
    const normalPriority = [...State.variables.xhsNormalPriority];
    const selected = [];
    

    for (let i = 0; i < 2 && highPriority.length > 0; i++) {
        if (Math.random() < 0.7) {
            const index = Math.floor(Math.random() * highPriority.length);
            selected.push(highPriority.splice(index, 1)[0]);
        }
    }
    

    const remaining = 4 - selected.length;
    const allRemaining = [...highPriority, ...normalPriority];
    
    for (let i = 0; i < remaining && allRemaining.length > 0; i++) {
        const index = Math.floor(Math.random() * allRemaining.length);
        selected.push(allRemaining.splice(index, 1)[0]);
    }
    
    State.variables.xhsMessages = selected;
};


window.checkTimedEvents = function() {
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const events = State.variables.timedEvents;
    let activeEvents = setup.activeLocationEvents;
    
    if (!events || !Array.isArray(events)) {
        console.log("No events array found");
        return;
    }
    
    if (!activeEvents) {
        activeEvents = [];
        setup.activeLocationEvents = activeEvents;
    }
    
    for (let i = 0; i < events.length; i++) {
        const event = events[i];
        //console.log("checkTimedEvents", currentHour, currentMinute, event.triggerHour, event.triggerMinute);
        const shouldActivate = (currentHour > event.triggerHour) || 
                              (currentHour === event.triggerHour && currentMinute >= event.triggerMinute);
        
        //console.log("shouldActivate", shouldActivate, event.active, event.triggered);
        if (shouldActivate && !event.active && !event.triggered) {
            if (event.isGlobal) {
                console.log("Triggering global event immediately:", event.id);
                event.triggered = true;
                setup.currentEvent = {
                    id: event.id,
                    location: event.location,
                    title: event.title,
                    description: event.description,
                    choices: event.choices,
                    active: true,
                    triggered: true,
                    importance: event.importance,
                    isGlobal: true,
                    persistent: event.persistent || false,
                    completed: event.completed || false,
                    completedChoices: event.completedChoices || []
                };

                setTimeout(function() {
                    Engine.play("触发事件");
                }, 100);
                return;
            }

            const endMinute = event.triggerMinute + event.duration;
            const endHour = event.triggerHour + Math.floor(endMinute / 60);
            const actualEndMinute = endMinute % 60;
            
            const shouldDeactivate = (currentHour > endHour) || 
                                   (currentHour === endHour && currentMinute >= actualEndMinute);
            
            if (!shouldDeactivate) {
                event.active = true;

                if (!activeEvents.find(e => e.id === event.id)) {
                     
                    const eventCopy = {
                        id: event.id,
                        location: event.location,
                        title: event.title,
                        description: event.description,
                        choices: event.choices,
                        active: true,
                        triggered: false,
                        importance: event.importance,
                        isGlobal: event.isGlobal || false,
                        persistent: event.persistent || false,
                        completed: event.completed || false,
                        completedChoices: event.completedChoices || []
                    };
                    activeEvents.push(eventCopy);
                }
            }
        }

        if (event.active) {
            
            if (event.persistent) {
                if (event.completed) {
                    event.active = false;
                    const index = activeEvents.findIndex(e => e.id === event.id);
                    if (index !== -1) {
                        activeEvents.splice(index, 1);
                    }
                }
            } else {
                const endMinute = event.triggerMinute + event.duration;
                const endHour = event.triggerHour + Math.floor(endMinute / 60);
                const actualEndMinute = endMinute % 60;
                
                const shouldDeactivate = (currentHour > endHour) || 
                                       (currentHour === endHour && currentMinute >= actualEndMinute);
                
                if (shouldDeactivate) {
                    event.active = false;
                    const index = activeEvents.findIndex(e => e.id === event.id);
                    if (index !== -1) {
                        activeEvents.splice(index, 1);
                    }
                }
            }
        }
    }
    
    setup.activeLocationEvents = activeEvents;
};

window.triggerLocationEvent = function(location) {
    var activeEvents = setup.activeLocationEvents;
    console.log("triggerLocationEvent", location, activeEvents);
    
    if (!activeEvents || !Array.isArray(activeEvents)) {
        console.log("activeEvents is not a valid array");
        return false;
    }
    
    var locationEvent = activeEvents.find(event => 
        event && event.location === location && event.active && (!event.triggered || (event.persistent && !event.completed))
    );
    
    if (locationEvent) {
        console.log("Found event to trigger:", locationEvent);
        
        if (!locationEvent.choices || !Array.isArray(locationEvent.choices)) {
            console.error("Event choices is not a valid array:", locationEvent.choices);
            return false;
        }
        
        if (locationEvent.choices.length === 0) {
            console.error("Event has no choices");
            return false;
        }
        
        for (let i = 0; i < locationEvent.choices.length; i++) {
            const choice = locationEvent.choices[i];
            if (!choice || !choice.text || !choice.action) {
                console.error("Invalid choice at index", i, choice);
                return false;
            }
        }
        
        locationEvent.triggered = true;
        setup.currentEvent = locationEvent;
        console.log("Event triggered successfully");
        return true;
    }
    
    console.log("No matching event found for location:", location);
    return false;
};
window.checkNewWechatMessages = function() {
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const pendingMessages = State.variables.pendingWechatMessages;
    
    if (!pendingMessages) return;
    
    for (let i = pendingMessages.length - 1; i >= 0; i--) {
        const msg = pendingMessages[i];
        const shouldTrigger = (currentHour > msg.triggerHour) || 
                            (currentHour === msg.triggerHour && currentMinute >= msg.triggerMinute);
        
        if (shouldTrigger) {
           
            const newMessage = {
                read: false,
                content: msg.content,
                from: msg.from,
                preview: msg.preview,
                hour: currentHour,
                minute: currentMinute,
                digitalKey: msg.digitalKey || null
            };
            State.variables.wechatMessages.push(newMessage);
            

            if (window.showToast && State.variables.toastNotificationsEnabled) {
                window.showToast(newMessage.from, newMessage.preview);
            }
            
            window.refreshCellphoneNotifications();

            pendingMessages.splice(i, 1);
        }
    }
};

window.refreshCellphoneNotifications = function() {
    var unread = 0;
    for (let i = 0; i < State.variables.wechatMessages.length; i++) {
        if (!State.variables.wechatMessages[i].read) {
            unread += 1;
        }
    }
    unread += State.variables.xhsMessages.length;
    State.variables.unreadCount = unread;
    
    if (unread > 0) {
        $('.notification-badge').text(unread).removeClass('hidden');
    } else {
        $('.notification-badge').addClass('hidden');
    }
};


window.checkWorkstationStatus = function() {

    if (!State.variables.workstationMonitoringEnabled) {
        return;
    }
    
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const currentLocation = State.variables.CurLocation;
    const lastAtWorkstation = State.variables.lastAtWorkstation;
    const threshold = State.variables.awayFromWorkstationThreshold;
    

    if (currentLocation === "工位") {
        State.variables.lastAtWorkstation = {hour: currentHour, minute: currentMinute};
        State.variables.workstationReminderSent = false;
        return;
    }
    

    const currentTotalMinutes = currentHour * 60 + currentMinute;
    const lastWorkstationTotalMinutes = lastAtWorkstation.hour * 60 + lastAtWorkstation.minute;
    const minutesAway = currentTotalMinutes - lastWorkstationTotalMinutes;
    

    if (minutesAway >= threshold && !State.variables.workstationReminderSent) {
        let reminderMessages = [];
        
        if (minutesAway >= threshold && minutesAway < threshold + 30) {
            reminderMessages = [
                {
                    content: "注意到你离开工位有一段时间了，记得回来继续测评工作哦！",
                    from: "飞鼠OA系统",
                    preview: "注意到你离开工位有一段时间了..."
                },
                {
                    content: "工作时间请尽量在工位专心工作，测评任务还需要完成呢！",
                    from: "飞鼠OA系统", 
                    preview: "工作时间请尽量在工位专心工作..."
                }
            ];
        } else if (minutesAway >= threshold + 30 && minutesAway < threshold + 60) {
            reminderMessages = [
                {
                    content: "你已经离开工位超过" + Math.floor(minutesAway) + "分钟了，请尽快回到工作岗位！",
                    from: "飞鼠OA系统",
                    preview: "你已经离开工位超过" + Math.floor(minutesAway) + "分钟了..."
                },
                {
                    content: "长时间离岗可能影响工作效率，建议立即返回工位继续测评工作。",
                    from: "飞鼠OA系统",
                    preview: "长时间离岗可能影响工作效率..."
                }
            ];
        } else {
            reminderMessages = [
                {
                    content: "严重提醒：你已经离开工位超过" + Math.floor(minutesAway) + "分钟！这可能影响项目进度，请立即返回工位！",
                    from: "飞鼠OA系统",
                    preview: "严重提醒：你已经离开工位超过" + Math.floor(minutesAway) + "分钟..."
                },
                {
                    content: "系统检测到严重的离岗行为，这将被记录在工作日志中。请立即回到工作岗位！",
                    from: "飞鼠OA系统",
                    preview: "系统检测到严重的离岗行为..."
                }
            ];
        }
        
        const reminderIndex = Math.min(State.variables.workstationReminderCount, reminderMessages.length - 1);
        const selectedReminder = reminderMessages[reminderIndex];
        
        const newMessage = {
            read: false,
            content: selectedReminder.content,
            from: selectedReminder.from,
            preview: selectedReminder.preview,
            hour: currentHour,
            minute: currentMinute
        };
        
        State.variables.wechatMessages.push(newMessage);
        

        if (window.showToast && State.variables.toastNotificationsEnabled) {
            let toastType = 'warning';
            let toastDuration = 5000;
            
            if (minutesAway >= threshold + 60) {
                toastType = 'error';
                toastDuration = 6000;
            } else if (minutesAway >= threshold + 30) {
                toastType = 'warning';
                toastDuration = 5000;
            } else {
                toastType = 'info';
                toastDuration = 4000;
            }
            
            window.showToast(newMessage.from, newMessage.preview, toastDuration, toastType);
        }
        
        State.variables.workstationReminderSent = true;
        State.variables.workstationReminderCount += 1;
        window.refreshCellphoneNotifications();
    }
};


window.addDigitalKey = function(room, duration) {
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const expireMinute = currentMinute + duration;
    const expireHour = currentHour + Math.floor(expireMinute / 60);
    const actualExpireMinute = expireMinute % 60;
    
    const digitalKey = {
        room: room,
        expireHour: expireHour,
        expireMinute: actualExpireMinute,
        duration: duration,
        obtainedHour: currentHour,
        obtainedMinute: currentMinute
    };
    
    State.variables.digitalKeys.push(digitalKey);
    console.log("Added digital key for", room, "expires at", expireHour + ":" + actualExpireMinute);
};

window.hasValidDigitalKey = function(room) {
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const currentTotalMinutes = currentHour * 60 + currentMinute;
    
    if (currentHour >= 19) {
        return false;
    }
    
    for (let i = 0; i < State.variables.digitalKeys.length; i++) {
        const key = State.variables.digitalKeys[i];
        if (key.room === room) {
            const keyExpireTotalMinutes = key.expireHour * 60 + key.expireMinute;
            if (currentTotalMinutes < keyExpireTotalMinutes) {
                return true;
            }
        }
    }
    return false;
};

window.cleanExpiredDigitalKeys = function() {
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const currentTotalMinutes = currentHour * 60 + currentMinute;
    
    State.variables.digitalKeys = State.variables.digitalKeys.filter(key => {
        const keyExpireTotalMinutes = key.expireHour * 60 + key.expireMinute;
        return currentTotalMinutes < keyExpireTotalMinutes;
    });
};

window.getDigitalKeyInfo = function(room) {
    const currentHour = State.variables.hour;
    const currentMinute = State.variables.minute;
    const currentTotalMinutes = currentHour * 60 + currentMinute;
    
    if (currentHour >= 19) {
        return { valid: false, reason: "19:00后电子钥匙系统关闭" };
    }
    
    for (let i = 0; i < State.variables.digitalKeys.length; i++) {
        const key = State.variables.digitalKeys[i];
        if (key.room === room) {
            const keyExpireTotalMinutes = key.expireHour * 60 + key.expireMinute;
            if (currentTotalMinutes < keyExpireTotalMinutes) {
                const remainingMinutes = keyExpireTotalMinutes - currentTotalMinutes;
                return {
                    valid: true,
                    remainingMinutes: remainingMinutes,
                    expireHour: key.expireHour,
                    expireMinute: key.expireMinute
                };
            }
        }
    }
    return { valid: false };
};

