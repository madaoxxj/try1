        <<if setup.currentEvent.completedChoices.length >= setup.currentEvent.choices.length>>
            <<set setup.currentEvent.completed = true>>
            <<set setup.currentEvent.active = false>>
            <<set setup.activeLocationEvents = setup.activeLocationEvents.filter(e => e.id !== setup.currentEvent.id)>>
        <</if>>
    <</if>>
<</widget>>


